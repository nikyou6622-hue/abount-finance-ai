# Abount Finance AI — Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.

# Supabase Credentials (Get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Automated Cron & Scraper Job Protection
CRON_SECRET=your-cron-secret-token-here

# Optional: Resend API Key for Email Digest Dispatcher
RESEND_API_KEY=re_your_resend_api_key_here
